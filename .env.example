# Copy to .env and fill in. .env is git-ignored; this file is not.
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Optional (Step 8)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# live = always call APIs | record = call and save | replay = saved answers only
CACHE_MODE=live
LOG_LEVEL=INFO
